{
    "name": "wilbert-caba-portfolio",
    "version": "1.0.0",
    "description": "A blank template to get started with Payload 3.0",
    "license": "MIT",
    "type": "module",
    "scripts": {
        "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
        "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
        "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
        "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
        "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
        "lint": "cross-env NODE_OPTIONS=--no-deprecation next lint",
        "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
        "start": "cross-env NODE_OPTIONS=--no-deprecation next start"
    },
    "dependencies": {
        "@payloadcms/db-postgres": "3.91.0",
        "@payloadcms/next": "3.91.0",
        "@payloadcms/payload-cloud": "3.91.0",
        "@payloadcms/richtext-lexical": "3.91.0",
        "@payloadcms/storage-s3": "3.91.0",
        "@payloadcms/ui": "3.91.0",
        "@radix-ui/react-dialog": "^1.1.1",
        "@radix-ui/react-slot": "^1.1.0",
        "@react-email/components": "^0.0.22",
        "@react-email/render": "^0.0.17",
        "@react-email/tailwind": "^0.0.19",
        "@supabase/ssr": "^0.3.0",
        "@supabase/supabase-js": "^2.43.4",
        "@vercel/postgres": "^0.8.0",
        "autoprefixer": "10.4.17",
        "class-variance-authority": "^0.7.0",
        "clsx": "^2.1.1",
        "cross-env": "^7.0.3",
        "eslint": "8.57.0",
        "eslint-config-next": "15.4.11",
        "framer-motion": "12.0.0-alpha.0",
        "graphql": "^16.8.1",
        "lucide-react": "^0.400.0",
        "next": "15.4.11",
        "payload": "3.91.0",
        "postcss": "8.4.35",
        "react": "19.2.6",
        "react-dom": "19.2.6",
        "react-error-boundary": "^4.0.13",
        "react-hot-toast": "^2.4.1",
        "react-icons": "^5.0.1",
        "react-intersection-observer": "^9.8.1",
        "react-vertical-timeline-component": "^3.6.0",
        "resend": "^4.0.0",
        "sharp": "0.35.4",
        "tailwind-merge": "^2.3.0",
        "tailwindcss": "3.4.1",
        "tailwindcss-animate": "^1.0.7"
