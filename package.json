    "devDependencies": {
        "@types/node": "^20.11.25",
        "@types/react": "19.2.14",
        "@types/react-dom": "19.2.3",
        "@types/react-vertical-timeline-component": "^3.3.6",
        "dotenv": "^16.4.5",
        "tsx": "^4.7.1",
        "typescript": "5.7.3"
    },
    "engines": {
        "node": ">=20.18.1"
    }
